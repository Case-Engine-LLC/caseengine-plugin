{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{website_url}}/#website",
      "url": "{{website_url}}",
      "name": "{{firm_name}}",
      "inLanguage": "en",
      "publisher": {
        "@type": "Organization",
        "@id": "{{website_url}}/#org",
        "name": "{{firm_name}}",
        "url": "{{website_url}}",
        "logo": {
          "@type": "ImageObject",
          "@id": "{{website_url}}/#logo",
          "url": "{{logo_url}}",
          "width": {{logo_width}},
          "height": {{logo_height}},
          "caption": "{{firm_name}}"
        },
        "sameAs": {{publisher_same_as_array}}
      }
    },
    {
      "@type": "WebPage",
      "@id": "{{page_url}}#webpage",
      "url": "{{page_url}}",
      "name": "{{page_title}}",
      "headline": "{{page_title}}",
      "inLanguage": "en",
      "isPartOf": { "@id": "{{website_url}}/#website" },
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "@id": "{{primary_image_url}}#primaryimage",
        "url": "{{primary_image_url}}",
        "width": {{primary_image_width}},
        "height": {{primary_image_height}}
      },
      "abstract": "{{tldr_abstract}}",
      "speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["article h1", "article .tldr-summary"]
      },
      "about": { "@id": "{{page_url}}#service" },
      "breadcrumb": { "@id": "{{page_url}}#breadcrumb" },
      "mainEntity": { "@id": "{{page_url}}#faq" },
      "hasPart": [
        { "@id": "{{page_url}}#faq" },
        { "@id": "{{page_url}}#how-to-claim" },
        { "@id": "{{page_url}}#case-results" }
      ]
    },
    {
      "@type": ["LegalService", "Attorney"],
      "@id": "{{website_url}}/#legalservice",
      "name": "{{firm_name}}",
      "legalName": "{{legal_name}}",
      "url": "{{website_url}}",
      "image": {
        "@type": "ImageObject",
        "@id": "{{office_image_url}}#image",
        "url": "{{office_image_url}}"
      },
      "logo": { "@id": "{{website_url}}/#logo" },
      "slogan": "{{slogan}}",
      "description": "{{location_description}}",
      "email": "mailto:{{email}}",
      "telephone": "{{telephone}}",
      "priceRange": "$$",
      "paymentAccepted": "Cash, Credit Card",
      "currenciesAccepted": "USD",
      "foundingDate": "{{founding_date}}",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "{{rating_value}}",
        "ratingCount": "{{rating_count}}",
        "reviewCount": "{{review_count}}",
        "bestRating": "5",
        "worstRating": "1"
      },
      "review": [
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "{{review1_author}}" },
          "datePublished": "{{review1_date}}",
          "reviewBody": "{{review1_body}}",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "{{review1_rating}}",
            "bestRating": "5",
            "worstRating": "1"
          }
        },
        {
          "@type": "Review",
          "author": { "@type": "Person", "name": "{{review2_author}}" },
          "datePublished": "{{review2_date}}",
          "reviewBody": "{{review2_body}}",
          "reviewRating": {
            "@type": "Rating",
            "ratingValue": "{{review2_rating}}",
            "bestRating": "5",
            "worstRating": "1"
          }
        }
      ],
      "foundingLocation": {
        "@type": "Place",
        "name": "{{founding_location}}"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{street_address}}",
        "addressLocality": "{{city}}",
        "addressRegion": "{{state_abbr}}",
        "postalCode": "{{postal_code}}",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{latitude}},
        "longitude": {{longitude}}
      },
      "hasMap": "{{google_maps_url}}",
      "areaServed": [
        { "@type": "City", "name": "{{city}}" },
        { "@type": "Place", "name": "{{greater_area}}" },
        { "@type": "AdministrativeArea", "name": "{{state_name}}" }
      ],
      "serviceArea": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": {{latitude}},
          "longitude": {{longitude}}
        },
        "geoRadius": {{service_radius_meters}}
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "{{opens_time}}",
          "closes": "{{closes_time}}"
        }
      ],
      "availableLanguage": {{available_languages_array}},
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "Intake",
          "telephone": "{{telephone}}",
          "email": "{{email}}",
          "availableLanguage": {{available_languages_array}},
          "areaServed": "US-{{state_abbr}}"
        }
      ],
      "memberOf": {{member_of_array}},
      "knowsAbout": {{knows_about_array}},
      "awards": {{awards_array}},
      "sameAs": {{same_as_array}},
      "specialty": {{specialty_array}},
      "makesOffer": {
        "@type": "OfferCatalog",
        "name": "Personal Injury Legal Services",
        "itemListElement": [
          {
            "@type": "Offer",
            "name": "{{service_type}} Attorney",
            "itemOffered": {
              "@type": "Service",
              "@id": "{{page_url}}#svc-main",
              "serviceType": "{{service_type}} Lawyer",
              "areaServed": "{{city}} {{state_abbr}}",
              "audience": {
                "@type": "Audience",
                "audienceType": "{{audience_type}}"
              }
            }
          }
        ]
      },
      "potentialAction": [
        {
          "@type": "ContactAction",
          "target": "{{page_url}}#free-consultation",
          "name": "Request a Free Consultation",
          "result": { "@type": "Thing", "name": "Consultation scheduled" }
        },
        {
          "@type": "SubscribeAction",
          "target": "{{website_url}}/newsletter",
          "name": "Subscribe to case updates"
        }
      ],
      "founder": {
        "@type": "Person",
        "@id": "{{website_url}}/#founder",
        "name": "{{founder_name}}",
        "jobTitle": "{{founder_title}}",
        "sameAs": {{founder_same_as_array}},
        "hasCredential": {
          "@type": "EducationalOccupationalCredential",
          "credentialCategory": "Professional license",
          "name": "{{bar_association_name}}",
          "url": "{{bar_association_url}}",
          "identifier": "{{bar_number}}"
        },
        "alumniOf": {
          "@type": "CollegeOrUniversity",
          "name": "{{law_school_name}}"
        }
      }
    },
    {
      "@type": "Service",
      "@id": "{{page_url}}#service",
      "name": "{{page_title}}",
      "serviceType": "{{service_type}} Attorney",
      "provider": { "@id": "{{website_url}}/#legalservice" },
      "areaServed": { "@type": "City", "name": "{{city}}" },
      "audience": { "@type": "Audience", "audienceType": "{{audience_type}}" },
      "termsOfService": "{{website_url}}/terms",
      "offers": {
        "@type": "Offer",
        "url": "{{page_url}}#free-consultation",
        "priceCurrency": "USD",
        "priceSpecification": {
          "@type": "PriceSpecification",
          "priceCurrency": "USD",
          "price": "0",
          "description": "Free consultation. No fee unless we win."
        },
        "eligibleRegion": "US-{{state_abbr}}",
        "availability": "https://schema.org/InStock",
        "businessFunction": "http://purl.org/goodrelations/v1#ProvideService",
        "category": "Contingency fee representation"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{page_url}}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{website_url}}/" },
        { "@type": "ListItem", "position": 2, "name": "{{practice_area}}", "item": "{{practice_area_url}}" },
        { "@type": "ListItem", "position": 3, "name": "{{page_title}}", "item": "{{page_url}}" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "{{page_url}}#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "{{faq1_question}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{faq1_answer}}"
          }
        },
        {
          "@type": "Question",
          "name": "{{faq2_question}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{faq2_answer}}"
          }
        },
        {
          "@type": "Question",
          "name": "{{faq3_question}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{faq3_answer}}"
          }
        },
        {
          "@type": "Question",
          "name": "{{faq4_question}}",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "{{faq4_answer}}"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "{{page_url}}#how-to-claim",
      "name": "How to file a {{service_type_lower}} claim in {{state_name}}",
      "description": "Step-by-step guide explaining how injured individuals can file a {{service_type_lower}} claim.",
      "inLanguage": "en",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Seek medical treatment",
          "text": "{{howto_step1_text}}"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Contact a {{city}} {{service_type_lower}} lawyer",
          "text": "{{howto_step2_text}}"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Preserve all evidence",
          "text": "{{howto_step3_text}}"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Allow your attorney to negotiate or file suit",
          "text": "{{howto_step4_text}}"
        }
      ]
    },
    {
      "@type": "LegalCase",
      "@id": "{{page_url}}#case-results",
      "name": "{{case_name}}",
      "description": "{{case_description}}",
      "caseNumber": "{{case_number}}",
      "jurisdiction": "{{state_name}}",
      "locationCreated": {
        "@type": "Place",
        "name": "{{city}}, {{state_abbr}}"
      },
      "party": [
        { "@type": "Person", "name": "Plaintiff (confidential)" },
        { "@type": "Organization", "name": "Defendant Insurance Company (confidential)" }
      ],
      "legalOutcome": "Settled",
      "result": {
        "@type": "MonetaryAmount",
        "currency": "USD",
        "value": "{{settlement_amount}}"
      },
      "legislationApplied": [
        { "@id": "{{website_url}}/legislation/{{statute_slug}}" }
      ],
      "provider": { "@id": "{{website_url}}/#legalservice" }
    },
    {
      "@type": "Legislation",
      "@id": "{{website_url}}/legislation/{{statute_slug}}",
      "name": "{{statute_name}}",
      "description": "{{statute_description}}",
      "jurisdiction": "{{state_name}}",
      "legislationIdentifier": "{{statute_identifier}}",
      "url": "{{statute_url}}"
    }
  ]
}
